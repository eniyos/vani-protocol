#!/usr/bin/env node
/**
 * Thin launcher: exec the platform binary that postinstall downloaded.
 * Falls back to the system PATH so `cargo install vani-mcp` also works.
 */

"use strict";

const path = require("path");
const fs = require("fs");
const { execFileSync } = require("child_process");

const IS_WIN = process.platform === "win32";
const BIN_NAME = IS_WIN ? "vani-mcp.exe" : "vani-mcp";
// The downloaded native binary lives in bin/native/ — separate from the JS
// wrapper at bin/vani-mcp so the existence check never false-positives.
const LOCAL_BIN = path.join(__dirname, "..", "bin", "native", BIN_NAME);

const bin = fs.existsSync(LOCAL_BIN) ? LOCAL_BIN : "vani-mcp";

try {
  execFileSync(bin, process.argv.slice(2), {
    stdio: "inherit",
    env: process.env,
  });
} catch (e) {
  if (e.status != null) process.exit(e.status);
  console.error("vani-mcp: failed to launch binary:", e.message);
  console.error("Try: cargo install vani-mcp");
  console.error("Or:  https://github.com/eniyos/vani-protocol/releases");
  process.exit(1);
}
