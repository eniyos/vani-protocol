# Copy to `.env` and adjust. Solana JSON-RPC endpoint (Devnet public by default — zero cost).
# Swap to a Helius endpoint later for rate limits / Mainnet.
RPC_URL=https://api.devnet.solana.com
# Optional: overriding the default demo address used by tools
VANI_DEFAULT_ADDRESS=
# Sarvam AI voice key (STT/TTS). Optional — without it, tts_speak/stt_transcribe return an error.
# Get a key at https://dashboard.sarvam.ai (shown only once at creation). Keep out of git.
SARVAM_API_KEY=
# --- Turnkey TEE signing (Week 3 execution layer). All optional — without them,
# turnkey_create_wallet / vani_execute return a clear "not configured" error.
# Create a free Turnkey org, then an API key pair (P-256) in the dashboard.
# The wallet PRIVATE key stays inside Turnkey's TEE — Vani only uses these API creds.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Address of the Turnkey wallet used as signer + fee payer (from turnkey_create_wallet).
TURNKEY_SOLANA_WALLET_ADDRESS=
# CAIP-2 chain for vani_execute. solana:devnet (default) | solana:mainnet
VANI_EXECUTE_NETWORK=solana:devnet