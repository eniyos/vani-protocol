# Copy to `.env` and fill in your values. Never commit `.env`.

# ── Solana RPC ────────────────────────────────────────────────────────────────
# Mainnet public endpoint (free, rate-limited ~10 req/s per IP).
# For production or higher volume use a dedicated endpoint:
#   Helius (recommended): https://dashboard.helius.dev  →  https://mainnet.helius-rpc.com/?api-key=<KEY>
#   QuickNode, Triton, Alchemy, etc.
# For devnet testing set: https://api.devnet.solana.com
RPC_URL=https://api.mainnet-beta.solana.com

# ── Chain target ──────────────────────────────────────────────────────────────
# CAIP-2 network identifier used in vani_execute output.
# solana:mainnet-beta  (default, real funds)
# solana:devnet        (testing, airdrop SOL)
VANI_EXECUTE_NETWORK=solana:mainnet-beta

# ── Optional: default wallet address ─────────────────────────────────────────
# Used when a tool's address field is left empty (e.g. get_balance with no arg).
VANI_DEFAULT_ADDRESS=

# ── Sarvam AI — voice layer (STT + TTS) ──────────────────────────────────────
# Get a free key at https://dashboard.sarvam.ai (shown only once at creation).
# Without this, tts_speak and stt_transcribe return a clear error — all other
# tools work fine.
SARVAM_API_KEY=

# ── Turnkey TEE signing — execution layer ────────────────────────────────────
# Create a free Starter org at https://app.turnkey.com, then generate a P-256
# API key pair in the dashboard. The wallet *private* key stays inside Turnkey's
# TEE — Vani only uses these API credentials to request signatures.
# Without these, turnkey_create_wallet and vani_execute return a clear error.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Address of the Turnkey wallet that signs and pays fees.
# Run turnkey_create_wallet once to get this, then paste it here.
# IMPORTANT: fund this address with real SOL on mainnet before calling vani_execute.
TURNKEY_SOLANA_WALLET_ADDRESS=
