# Copy to `.env` and adjust. Solana JSON-RPC endpoint (Devnet public by default — zero cost).
# Swap to a Helius endpoint later for rate limits / Mainnet.
RPC_URL=https://api.devnet.solana.com
# Optional: overriding the default demo address used by tools
VANI_DEFAULT_ADDRESS=
# Sarvam AI voice key (STT/TTS). Optional — without it, tts_speak/stt_transcribe return an error.
# Get a key at https://dashboard.sarvam.ai (shown only once at creation). Keep out of git.
SARVAM_API_KEY=